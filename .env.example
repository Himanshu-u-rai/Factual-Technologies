# PostgreSQL settings (for docker-compose.prod.yml / docker-compose.yml)
POSTGRES_USER="factual"
POSTGRES_PASSWORD="CHANGE_THIS_PASSWORD"
POSTGRES_DB="factual_techno"

# Database connection string (use @postgres:5432 inside docker-compose.prod.yml, or @127.0.0.1:5433 locally)
DATABASE_URL="postgresql://factual:CHANGE_THIS_PASSWORD@127.0.0.1:5433/factual_techno"

# Strong random secret for HMAC cookie verification (generate with: openssl rand -hex 32)
SESSION_SECRET="CHANGE_TO_64_CHAR_RANDOM_HEX"

# Canonical site origin used inside verification and password reset emails
APP_ORIGIN="https://your-domain.com"

# Reverse proxy header trust ("true" behind nginx/Caddy; set "false" if directly exposed without a proxy)
TRUST_PROXY="true"

# Recommended on public VPS deploy: require this token on /admin/setup before creating the sole admin
SETUP_TOKEN="CHANGE_TO_ONE_TIME_BOOTSTRAP_SECRET"

# SMTP credentials (for admin verification emails, password resets, and inquiry notifications)
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Factual Technologies <noreply@your-domain.com>"
